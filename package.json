{
  "name": "veylens",
  "version": "1.1.0",
  "description": "Privacy-leak auditor for Zcash shielded cross-chain transaction flows",
  "type": "module",
  "bin": {
    "veylens": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-reporter=spec dist/test/*.test.js",
    "build:web": "npm run build && node dist/src/web/build.js",
    "audit:demo:leak": "npm run build && node dist/src/cli.js audit test/fixtures/zashi-crosspay-leak.json",
    "audit:demo:html": "npm run build && node dist/src/cli.js audit test/fixtures/zashi-crosspay-leak.json --html",
    "audit:demo:clean": "npm run build && node dist/src/cli.js audit test/fixtures/clean-flow.json",
    "evidence:capture": "node scripts/capture-dry-quote.mjs",
    "zcash:capture": "npm run build && node scripts/capture-zcash.mjs",
    "test:browser": "playwright test",
    "capture:case": "npm run build && node scripts/capture-case.mjs",
    "check:submission": "npm run build && node scripts/check-submission.mjs",
    "dev": "npm run build:web && node scripts/serve-dev.mjs",
    "db:generate": "drizzle-kit generate",
    "check:deployment": "npm run build && node scripts/check-deployment.mjs",
    "collector:keygen": "node scripts/collector-keygen.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.3",
    "@playwright/test": "1.64.1",
    "@cloudflare/workers-types": "5.20261021.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6"
  }
}
